# Server
PORT=3001
NODE_ENV=development

# MongoDB — reuse your Atlas Cluster0, just point to the sana_travel database
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/sana_travel?retryWrites=true&w=majority

# JWT (session 3)
JWT_SECRET=change-me-sana-jwt-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-sana-refresh-secret

# LLM for SANA concierge (session 3) — Groq free tier
GROQ_API_KEY=
